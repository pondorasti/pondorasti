{
  "name": "@pondorasti/monorepo",
  "version": "0.0.0",
  "description": "Mission control for pondorasti",
  "author": "Alexandru Ţurcanu",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "private": true,
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "bun run --filter \"./apps/*\" --filter \"./packages/*\" typecheck",
    "test": "bun run --filter \"./apps/*\" --filter \"./packages/*\" test",
    "build": "bun run --filter \"./apps/*\" --filter \"./packages/*\" build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "lefthook": "2.1.12",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0"
  }
}
