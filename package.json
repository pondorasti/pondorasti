{
  "name": "@pondorasti/monorepo",
  "version": "0.0.0",
  "description": "Mission control for pondorasti",
  "author": "Alexandru Ţurcanu",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
      "vitest": "4.1.11",
      "vite-plus": "0.3.3"
    }
  },
  "private": true,
  "scripts": {
    "prepare": "vp config --no-agent",
    "check": "vp check && vp run -r --cache test && vp run -r --cache build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
