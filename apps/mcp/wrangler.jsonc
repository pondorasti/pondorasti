{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandru-mcp",
  "account_id": "630f294bcb2c1e9b751d9fe0655a453a",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  // global_fetch_strictly_public: SSRF guard for Client ID Metadata Document fetches
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.alexandru.so", "custom_domain": true }],
  "secrets": {
    "required": ["HEVY_API_KEY", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "NOTION_TOKEN"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://mcp.alexandru.so",
    "LOGIN_GOOGLE_EMAIL": "pondorasti@gmail.com"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "618183a52cfd4b43ab08e41ced1b8423" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
