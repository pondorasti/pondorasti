{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandru-mcp",
  "account_id": "630f294bcb2c1e9b751d9fe0655a453a",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  // global_fetch_strictly_public: SSRF guard for Client ID Metadata Document fetches
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mcp.alexandru.so", "custom_domain": true }],
  "secrets": { "required": ["LOGIN_PASSWORD", "HEVY_API_KEY"] },
  "vars": { "PUBLIC_ORIGIN": "https://mcp.alexandru.so" },
  // No id: wrangler provisions the namespace on first deploy
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
