{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandru-macro",
  "account_id": "630f294bcb2c1e9b751d9fe0655a453a",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "macro.alexandru.so", "custom_domain": true }],
  "vars": {
    "PUBLIC_ORIGIN": "https://macro.alexandru.so",
    "GITHUB_REPOSITORY": "pondorasti/pondorasti",
    "GITHUB_BRANCH": "main"
  },
  // Set on the Worker in the Cloudflare dashboard; deploys fail until both exist.
  "secrets": { "required": ["HEALTH_INGEST_TOKEN", "GITHUB_TOKEN"] }
}
