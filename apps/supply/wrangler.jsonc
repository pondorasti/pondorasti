{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandru-supply",
  "account_id": "630f294bcb2c1e9b751d9fe0655a453a",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "alexandru.supply", "custom_domain": true },
    { "pattern": "supply.alexandru.so", "custom_domain": true }
  ],
  "secrets": { "required": ["NOTION_TOKEN", "SYNC_SECRET"] },
  "vars": {
    "NOTION_DATA_SOURCE_ID": "3b6b49ce-7f0b-80cd-ad07-000b96417ff1",
    "PUBLIC_ORIGIN": "https://alexandru.supply",
    "IMAGE_ALLOWED_HOSTS": "isntree-global.com,cdsassets.apple.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alexandru-supply",
      "database_id": "1edcb7f5-a2e8-4524-b5f2-bdbb55fb0671",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "alexandru-supply-images" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
