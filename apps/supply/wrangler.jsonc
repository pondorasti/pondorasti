{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alexandru-supply",
  "account_id": "630f294bcb2c1e9b751d9fe0655a453a",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "alexandru.supply", "custom_domain": true },
    { "pattern": "supply.alexandru.so", "custom_domain": true }
  ],
  "vars": { "PUBLIC_ORIGIN": "https://alexandru.supply" }
}
